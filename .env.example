# Copy this file to .env and fill in your real key:
#     cp .env.example .env
# .env is gitignored and must never be committed.

# Required to run experiments against OpenAI.
OPENAI_API_KEY=sk-your-key-here

# Optional: point at an OpenAI-compatible gateway instead of api.openai.com.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: only needed if you run with --provider anthropic.
# ANTHROPIC_API_KEY=sk-ant-your-key-here
