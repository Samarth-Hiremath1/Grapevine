# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# uv
.uv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Environment / secrets -- never commit real credentials.
# The example file is the one exception and must stay tracked.
.env
.env.*
!.env.example

# Rollout / training artifacts. Runs are large, so a run is NOT committed by
# default: a reported run is added deliberately with `git add -f`, which is why
# the committed runs under studies/*/runs/ stay tracked despite these patterns.
runs/
outputs/
*.jsonl
!tests/**/*.jsonl
checkpoints/
wandb/

# OS
.DS_Store
